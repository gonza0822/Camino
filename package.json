{
  "name": "camino",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first ./node_modules/next/dist/bin/next dev",
    "test:db": "node --dns-result-order=ipv4first scripts/test-db.mjs",
    "db:find-primary": "node --dns-result-order=ipv4first scripts/find-primary.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:prepare": "node scripts/prepare-electron-config.mjs",
    "electron:build": "node scripts/prepare-electron-config.mjs && electron-builder --win",
    "electron:build:dir": "node scripts/prepare-electron-config.mjs && electron-builder --win --dir",
    "cap:prepare": "node scripts/prepare-capacitor-config.mjs",
    "cap:sync": "node scripts/prepare-capacitor-config.mjs && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/react": "^4.0.40",
    "@auth/mongodb-adapter": "^3.11.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.37",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.42.2",
    "mongodb": "^6.21.0",
    "mongoose": "^9.7.3",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.camino.app",
    "productName": "Camino",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "electron/**/*",
      "public/brand/logo-camino.png",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/brand/logo-camino.png",
      "artifactName": "Camino-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Camino"
    }
  }
}
